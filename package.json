{
  "name": "django-react-app-v2",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/web",
    "apps/worker",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "npm start --workspace=apps/web",
    "db:generate": "npm run generate --workspace=packages/db",
    "db:migrate:dev": "npm run migrate:dev --workspace=packages/db",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=packages/db",
    "generate:tree": "find . -name 'node_modules' -prune -o -name '.git' -prune -o -name '.next' -prune -o -name '__pycache__' -prune -o -name '.venv' -prune -o -name 'dist' -prune -o -name 'build' -prune -o -name '.terraform' -prune -o -name '.turbo' -prune -o -name '*.pyc' -prune -o -name 'uv.lock' -prune -o -name 'package-lock.json' -prune -o -name 'migration_lock.toml' -prune -o -type f -print | sort > ai-directory-structure.txt"
  },
  "devDependencies": {
    "turbo": "latest"
  },
  "overrides": {
    "effect": "^3.20.0"
  }
}