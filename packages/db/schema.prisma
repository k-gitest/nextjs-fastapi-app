generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  auth0Id   String   @unique // Auth0の "sub" を入れる
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  todos     Todo[]
  albums    Album[]
  images    Image[]
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Todo {
  id          String   @id @default(cuid())
  todo_title  String   // DjangoのCharField(max_length=255)相当
  
  // Djangoのchoices相当。型安全になります
  priority    Priority @default(MEDIUM)
  
  // DjangoのIntegerField相当
  progress    Int      @default(0)

  // Djangoのauto_now_addとauto_now相当
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Userとの紐付け
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  todoImages TodoImage[]

  // Djangoのordering（作成日降順）はクエリ時に指定するのが一般的ですが、
  // indexを貼っておくと高速になります
  @@index([createdAt(sort: Desc)])
}

model Album {
  id           String   @id @default(cuid())
  name         String
  displayOrder Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  images       Image[]

  @@unique([userId, name])
  @@index([userId, displayOrder])
}

model Image {
  id               String   @id @default(cuid())

  storageKey       String   // B2オブジェクトキー（uploads/{uuid}.ext）
                            // opaqueな識別子であり、所有権・分類情報を含まない。所有権はImage.userIdが唯一の情報源。
  originalFileName String   // ユーザーがアップロードした元のファイル名

  mimeType         String   // image/jpeg | image/png | image/gif | image/webp
  fileSize         Int      // バイト数（Phase1上限: 10MB = 10 * 1024 * 1024）

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  albumId          String?
  album            Album?   @relation(fields: [albumId], references: [id], onDelete: Restrict)

  todoImages       TodoImage[]

  @@index([albumId])
  @@index([userId])
  @@index([userId, albumId])
}

// 中間テーブル
model TodoImage {
  id        String   @id @default(cuid())
  todoId    String
  imageId   String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  image     Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([todoId, imageId])
  @@index([todoId, order])
}

// outboxパターン
// status用の列挙型
enum OutboxStatus {
  pending
  processing
  retrying
  sent
  failed
}

model outbox_events {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregate_id    String       @db.VarChar(128) 
  event_type      String       @db.VarChar(64)
  event_version   Int          @default(1)      // 追加: 将来のスキーマ変更用
  payload         Json
  status          OutboxStatus @default(pending)
  retry_count     Int          @default(0)
  last_error      String?      @db.Text
  idempotency_key String       @unique          // 修正: NOT NULL (Next.js側で生成必須)
  
  locked_at       DateTime?    @db.Timestamptz
  next_retry_at   DateTime     @default(now()) @db.Timestamptz
  created_at      DateTime     @default(now()) @db.Timestamptz
  processed_at    DateTime?    @db.Timestamptz
  updated_at      DateTime     @default(now()) @updatedAt @db.Timestamptz

  @@index([status, locked_at, next_retry_at, created_at])
}

// fastapi側で冪等性チェック用
model processed_events {
  id              Int      @id @default(autoincrement())
  handler_name    String
  idempotency_key String
  // PostgreSQLのTimestamptzを使うことで、サーバーのタイムゾーン設定に依存しない運用が可能です
  processed_at    DateTime @default(now()) @db.Timestamptz

  @@unique([handler_name, idempotency_key]) // 拡張的に複合ユニークにしておく
  @@index([processed_at])
}

enum StorageCleanupReason {
  image_create_failed
  b2_delete_failed
}

enum StorageCleanupStatus {
  pending
  processing
  resolved
  failed
}

// Type A（B2 PUT成功後のImage INSERT失敗）とType B（Image DELETE成功後のB2 DELETE失敗）
// で発生する孤立storageKeyを記録するGC対象管理テーブル。
//
// Phase3-8では registerStorageCleanupTask() によるpending登録までを行う。
// nextRetryAt / lockedAt / processing / failed は将来Worker化する際に必要になる
// フィールド・状態を先に確保しているだけで、現時点ではWorkerによるpolling・
// ロック取得・指数バックオフは実装しない（手動スクリプトがpendingを取得して処理する）。
//
// reasonはType A/Bの発生原因を記録するだけで、回収ロジック自体は共通
// （どちらも「Imageが存在しないstorageKeyをB2から削除する」という同一アクション）。
model StorageCleanupTask {
  id            String                @id @default(cuid())
  storageKey    String                @unique
  reason        StorageCleanupReason

  status        StorageCleanupStatus  @default(pending)
  retryCount    Int                   @default(0)
  nextRetryAt   DateTime              @default(now())
  lockedAt      DateTime?
  lastError     String?               @db.Text

  createdAt     DateTime              @default(now())
  lastAttemptAt DateTime?
  resolvedAt    DateTime?

  @@index([status, nextRetryAt, createdAt])
}