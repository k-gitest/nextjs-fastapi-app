generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  auth0Id   String   @unique // Auth0の "sub" を入れる
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  todos     Todo[]
  albums    Album[]
  images    Image[]
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Todo {
  id          String   @id @default(cuid())
  todo_title  String
  
  priority    Priority @default(MEDIUM)
  progress    Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Userとの紐付け
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  todoImages TodoImage[]

  @@index([createdAt(sort: Desc)])
}

model Album {
  id           String   @id @default(cuid())
  name         String
  displayOrder Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  images       Image[]

  @@unique([userId, name])
  @@index([userId, displayOrder])
}

model Image {
  id               String   @id @default(cuid())

  storageKey       String   @unique // B2オブジェクトキー（uploads/{uuid}.ext）
                            // opaqueな識別子であり、所有権・分類情報を含まない。所有権はImage.userIdが唯一の情報源。
                            // API境界（POST /api/images）でクライアント申告値の重複登録を防ぐため@unique
  originalFileName String   // ユーザーがアップロードした元のファイル名

  mimeType         String   // image/jpeg | image/png | image/gif | image/webp
  fileSize         Int      // バイト数（Phase1上限: 10MB = 10 * 1024 * 1024）

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  albumId          String?
  album            Album?   @relation(fields: [albumId], references: [id], onDelete: Restrict)

  // Album内での表示順。albumId が非null の場合は必ず非null、
  // albumId が null（未所属）の場合は必ず null という不変条件を持つ
  // （updateImageAlbum・reorderAlbumImages の両方でこの不変条件を維持する）。
  albumDisplayOrder Int?

  todoImages       TodoImage[]

  @@index([albumId])
  @@index([userId])
  @@index([userId, albumId])
  @@index([albumId, albumDisplayOrder])
}

// 中間テーブル
model TodoImage {
  id        String   @id @default(cuid())
  todoId    String
  imageId   String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  image     Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([todoId, imageId])
  @@index([todoId, order])
}

// outboxパターン
// status用の列挙型
enum OutboxStatus {
  pending
  processing
  retrying
  sent
  failed
}

model outbox_events {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregate_id    String       @db.VarChar(128) 
  event_type      String       @db.VarChar(64)
  event_version   Int          @default(1)      // 追加: 将来のスキーマ変更用
  payload         Json
  status          OutboxStatus @default(pending)
  retry_count     Int          @default(0)
  last_error      String?      @db.Text
  idempotency_key String       @unique          // 修正: NOT NULL (Next.js側で生成必須)
  
  locked_at       DateTime?    @db.Timestamptz
  next_retry_at   DateTime     @default(now()) @db.Timestamptz
  created_at      DateTime     @default(now()) @db.Timestamptz
  processed_at    DateTime?    @db.Timestamptz
  updated_at      DateTime     @default(now()) @updatedAt @db.Timestamptz

  @@index([status, locked_at, next_retry_at, created_at])
}

// fastapi側で冪等性チェック用
model processed_events {
  id              Int      @id @default(autoincrement())
  handler_name    String
  idempotency_key String
  // PostgreSQLのTimestamptzを使うことで、サーバーのタイムゾーン設定に依存しない運用が可能です
  processed_at    DateTime @default(now()) @db.Timestamptz

  @@unique([handler_name, idempotency_key]) // 拡張的に複合ユニークにしておく
  @@index([processed_at])
}

enum StorageCleanupReason {
  image_create_failed
}

enum StorageCleanupStatus {
  pending
  processing
  resolved
  failed
}

// B2 PUT成功後のImage INSERT失敗（image_create_failed）で発生する
// 孤立storageKeyを記録するGC対象管理テーブル。
//
// nextRetryAt / lockedAt / status(processing/failed)を用いて、
// Worker（apps/worker/src/storageCleanupWorkerService.ts）が
// FOR UPDATE SKIP LOCKEDによる原子的claim・指数バックオフリトライで定期回収する。
// 詳細はREADME.md「GC（孤立B2オブジェクトの検知・回収）」を参照。
// reasonは発生原因を記録するためのフィールド。
model StorageCleanupTask {
  id            String                @id @default(cuid())
  storageKey    String                @unique
  reason        StorageCleanupReason

  status        StorageCleanupStatus  @default(pending)
  retryCount    Int                   @default(0)
  nextRetryAt   DateTime              @default(now())
  lockedAt      DateTime?
  lastError     String?               @db.Text

  createdAt     DateTime              @default(now())
  lastAttemptAt DateTime?
  resolvedAt    DateTime?

  @@index([status, nextRetryAt, createdAt])
}